DISCORD_TOKEN=replace-with-your-discord-bot-token
OPENAI_API_KEY=replace-with-your-openai-api-key

# Optional: guild commands update immediately while testing.
DISCORD_GUILD_ID=

# Optional comma-separated channel IDs. Leave empty to answer only /ask and mentions.
SUPPORT_CHANNEL_IDS=
AUTO_REPLY=false

OPENAI_MODEL=gpt-5.6
USER_COOLDOWN_SECONDS=20
MAX_ATTACHMENT_BYTES=262144

