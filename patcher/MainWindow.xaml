<Window x:Class="LegacyCrossplayPatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Legacy Crossplay Patcher"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        FontFamily="Segoe UI"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
  <Grid x:Name="RootGrid" Background="{StaticResource CanvasBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="224" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#172033">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="92" />
          <RowDefinition Height="*" />
          <RowDefinition Height="90" />
        </Grid.RowDefinitions>

        <Grid Margin="20,17,16,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="46" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Width="38" Height="38" Background="#176BCE" CornerRadius="5" VerticalAlignment="Top">
            <TextBlock Text="LC"
                       Foreground="White"
                       FontWeight="Bold"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextWrapping="NoWrap" />
          </Border>
          <StackPanel Grid.Column="1" Margin="10,1,0,0">
            <TextBlock Text="LEGACY"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="Bold"
                       TextWrapping="NoWrap" />
            <TextBlock Text="CROSSPLAY PATCHER"
                       Foreground="#91A3BC"
                       FontSize="10"
                       TextWrapping="NoWrap" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
          <Button x:Name="PatchNavButton"
                  Style="{StaticResource NavButton}"
                  Click="PatchNavButton_Click"
                  Background="#263A57"
                  Foreground="White">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74C;" Foreground="White" FontSize="15" Width="29" />
              <TextBlock Text="Patch client" Foreground="White" TextWrapping="NoWrap" />
            </StackPanel>
          </Button>
          <Button x:Name="GuideNavButton"
                  Style="{StaticResource NavButton}"
                  Click="GuideNavButton_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE82D;" Foreground="#C9D3E2" FontSize="15" Width="29" />
              <TextBlock Text="Setup guide" Foreground="#C9D3E2" TextWrapping="NoWrap" />
            </StackPanel>
          </Button>
          <Button x:Name="LogNavButton"
                  Style="{StaticResource NavButton}"
                  Click="LogNavButton_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" Foreground="#C9D3E2" FontSize="15" Width="29" />
              <TextBlock Text="Activity log" Foreground="#C9D3E2" TextWrapping="NoWrap" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="20,0,16,18" VerticalAlignment="Bottom">
          <Border Height="1" Background="#2C3A50" Margin="0,0,0,13" />
          <TextBlock Text="PATCH-ONLY UTILITY" Foreground="#8091A9" FontSize="10" FontWeight="SemiBold" />
          <TextBlock Text="No game files are uploaded" Foreground="#B5C0D0" FontSize="11" Margin="0,3,0,0" />
          <TextBlock Text="Version 0.2.0" Foreground="#687A94" FontSize="10" Margin="0,2,0,0" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="72" />
        <RowDefinition Height="*" />
        <RowDefinition Height="34" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
        <Grid Margin="28,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="PageTitleText" Text="Patch client" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="PageSubtitleText"
                       Text="Validate, configure, patch, and build one supported client."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,3,0,0" />
          </StackPanel>
          <Border Grid.Column="1"
                  Background="#EAF7F1"
                  BorderBrush="#B9E1CF"
                  BorderThickness="1"
                  CornerRadius="4"
                  Padding="10,6"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Margin="0,0,7,0" />
              <TextBlock Text="Local processing" Foreground="{StaticResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="28,22,28,18">
        <ScrollViewer x:Name="PatchPage" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="13" Background="#E8F1FC" VerticalAlignment="Top">
                    <TextBlock Text="1" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Choose your game file" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Supported signatures: Windows EXE, Xbox 360 XEX, PS3 PKG, and PS3 SELF/EBOOT."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
                <Grid Margin="34,15,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="102" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="TargetPathBox"
                           Style="{StaticResource InputBox}"
                           IsReadOnly="True"
                           ToolTip="Drop a supported file anywhere in this window" />
                  <Button Grid.Column="1"
                          Style="{StaticResource SecondaryButton}"
                          Margin="8,0,0,0"
                          Click="BrowseTargetButton_Click">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14" Margin="0,0,7,0" />
                      <TextBlock Text="Browse" TextWrapping="NoWrap" />
                    </StackPanel>
                  </Button>
                </Grid>
                <Border x:Name="TargetResultBorder"
                        Margin="34,12,0,0"
                        Background="#F6F8FB"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="12"
                        Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock x:Name="TargetFormatText" FontWeight="SemiBold" FontSize="12" />
                      <TextBlock x:Name="TargetHashText"
                                 Foreground="{StaticResource MutedBrush}"
                                 FontFamily="Consolas"
                                 FontSize="10"
                                 Margin="0,4,0,0"
                                 TextTrimming="CharacterEllipsis"
                                 TextWrapping="NoWrap" />
                    </StackPanel>
                    <Border x:Name="TargetStatusBadge" Grid.Column="1" CornerRadius="4" Padding="9,4" Background="#EAF7F1" VerticalAlignment="Center">
                      <TextBlock x:Name="TargetStatusText" Text="SUPPORTED" Foreground="{StaticResource SuccessBrush}" FontSize="10" FontWeight="Bold" />
                    </Border>
                  </Grid>
                </Border>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="13" Background="#E8F1FC" VerticalAlignment="Top">
                    <TextBlock Text="2" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Select the matching source folder" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="The source is verified against the tested LCE 1.2.3 / net 495 baseline before anything changes."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
                <Grid Margin="34,15,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="102" />
                  </Grid.ColumnDefinitions>
                  <TextBox x:Name="SourcePathBox" Style="{StaticResource InputBox}" IsReadOnly="True" />
                  <Button Grid.Column="1"
                          Style="{StaticResource SecondaryButton}"
                          Margin="8,0,0,0"
                          Click="BrowseSourceButton_Click">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14" Margin="0,0,7,0" />
                      <TextBlock Text="Browse" TextWrapping="NoWrap" />
                    </StackPanel>
                  </Button>
                </Grid>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="26" Height="26" CornerRadius="13" Background="#E8F1FC" VerticalAlignment="Top">
                    <TextBlock Text="3" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Relay configuration" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Use the same address, session, build ID, and token on every platform."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>

                <Grid Margin="34,16,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.2*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Relay host" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="HostBox" Style="{StaticResource InputBox}" Text="127.0.0.1" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Port" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PortBox" Style="{StaticResource InputBox}" Text="61000" />
                  </StackPanel>
                  <StackPanel Grid.Column="4">
                    <TextBlock Text="Mode" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ModeBox" Height="38" SelectedIndex="0" Padding="8,5" FontSize="13">
                      <ComboBoxItem Content="local" />
                      <ComboBoxItem Content="vps" />
                    </ComboBox>
                  </StackPanel>
                </Grid>

                <Grid Margin="34,13,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="2*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Session ID" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SessionBox" Style="{StaticResource InputBox}" Text="local-test" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Build ID" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="BuildIdBox"
                             Style="{StaticResource InputBox}"
                             Text="584111F7-1.0.10.0-lce1.2.3-net495-proto39" />
                  </StackPanel>
                </Grid>

                <StackPanel Margin="34,13,0,0">
                  <TextBlock Text="Access token (optional for LAN)" Style="{StaticResource FieldLabel}" />
                  <TextBox x:Name="TokenBox" Style="{StaticResource InputBox}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelBorder}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="ActionStatusText" Text="Ready for validation" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock x:Name="ActionDetailText"
                             Text="Choose a game file and matching source folder."
                             Foreground="{StaticResource MutedBrush}"
                             FontSize="11"
                             Margin="0,3,0,0" />
                  <ProgressBar x:Name="WorkProgress"
                               Height="4"
                               Margin="0,14,0,0"
                               IsIndeterminate="True"
                               Visibility="Collapsed"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                  <Button x:Name="ValidateButton"
                          Style="{StaticResource SecondaryButton}"
                          Click="ValidateButton_Click"
                          Content="Validate"
                          MinWidth="92" />
                  <Button x:Name="ApplyButton"
                          Style="{StaticResource PrimaryButton}"
                          Click="ApplyButton_Click"
                          Content="Apply patch"
                          MinWidth="106"
                          Margin="8,0,0,0" />
                  <Button x:Name="BuildButton"
                          Style="{StaticResource SecondaryButton}"
                          Click="BuildButton_Click"
                          Content="Build client"
                          MinWidth="104"
                          Margin="8,0,0,0"
                          IsEnabled="False" />
                  <Button x:Name="OpenOutputButton"
                          Style="{StaticResource SecondaryButton}"
                          Click="OpenOutputButton_Click"
                          Content="Open output"
                          MinWidth="104"
                          Margin="8,0,0,0"
                          Visibility="Collapsed" />
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <Grid x:Name="GuidePage" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource PanelBorder}" Padding="10">
            <StackPanel>
              <TextBlock Text="GUIDE TOPICS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="10,8,10,9" />
              <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Content="Quick start" Margin="0,0,0,6" Click="QuickGuideButton_Click" />
              <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Content="PC / Windows" Margin="0,0,0,6" Click="PcGuideButton_Click" />
              <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Content="Xbox 360 / Xenia" Margin="0,0,0,6" Click="XboxGuideButton_Click" />
              <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Content="PS3 / RPCS3" Margin="0,0,0,6" Click="Ps3GuideButton_Click" />
              <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Content="Relay and VPS" Margin="0,0,0,6" Click="RelayGuideButton_Click" />
              <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Content="Troubleshooting" Click="TroubleshootingGuideButton_Click" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="28,24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock x:Name="GuideTitleText" Text="Quick start" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="GuideIntroText"
                           Text="Patch one verified source tree, then build every participating platform from that same revision."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="13"
                           Margin="0,7,0,22" />
                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,20" />
                <TextBlock x:Name="GuideBodyText" FontSize="13" LineHeight="22" />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <Grid x:Name="LogPage" Visibility="Collapsed">
          <Border Style="{StaticResource PanelBorder}" Padding="0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Margin="18,0">
                <TextBlock Text="Patch and build activity" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button Style="{StaticResource SecondaryButton}" Height="32" Content="Copy log" Click="CopyLogButton_Click" />
                  <Button Style="{StaticResource SecondaryButton}" Height="32" Content="Clear" Margin="7,0,0,0" Click="ClearLogButton_Click" />
                </StackPanel>
              </Grid>
              <TextBox x:Name="LogBox"
                       Grid.Row="1"
                       IsReadOnly="True"
                       AcceptsReturn="True"
                       VerticalScrollBarVisibility="Auto"
                       HorizontalScrollBarVisibility="Auto"
                       FontFamily="Consolas"
                       FontSize="11"
                       Background="#111827"
                       Foreground="#D8E1EE"
                       BorderThickness="0"
                       Padding="16"
                       TextWrapping="NoWrap" />
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="28,0">
          <TextBlock x:Name="FooterStatusText"
                     Text="Idle"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="10"
                     VerticalAlignment="Center" />
          <TextBlock Text="LCE 1.2.3 · net 495 · protocol 39"
                     Foreground="#8A95A7"
                     FontSize="10"
                     HorizontalAlignment="Right"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
